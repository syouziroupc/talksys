{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "talksys-telephony",
  "main": "src/index.js",
  "compatibility_date": "2026-09-17",
  "workers_dev": true,
  "vars": {
    "TELEPHONY_ENABLED": "false",
    "TELEPHONY_STORAGE_MODE": "disabled",
    "TELEPHONY_AUTO_GREETING": "true",
    "GEMINI_LIVE_MODEL": "gemini-3.8-live",
    "BROWSER_TALKSYS_URL": "https://talksys.syouziroupc.workers.dev"
  },
  "observability": {
    "enabled": true
  }
}
