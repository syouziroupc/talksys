{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "talksys",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-28",
  "compatibility_flags": ["nodejs_compat"],
  "ai": {
    "binding": "AI"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "TalkSysVoiceAgent",
        "class_name": "TalkSysVoiceAgent"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-voice",
      "new_sqlite_classes": ["TalkSysVoiceAgent"]
    }
  ]
}
