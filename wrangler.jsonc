{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "talksys",
  // Rollback markers: "main": "src/worker-v20.js", "main": "src/worker-v21.js", "main": "src/worker-v22.js", "main": "src/worker-v23-production.js"
  "main": "src/worker-v24-production.js",
  "compatibility_date": "2026-08-30",
  "compatibility_flags": ["nodejs_compat"],
  "ai": {
    "binding": "AI"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "TalkSysVoiceAgent",
        "class_name": "TalkSysVoiceAgent"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-voice",
      "new_sqlite_classes": ["TalkSysVoiceAgent"]
    }
  ]
}
