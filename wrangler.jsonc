{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "talksys",
  // v33 removed the legacy Durable Object / WebSocket voice stack; later versions keep that clean architecture.
  // Historical rollback markers retained for regression contracts:
  // "main": "src/worker-v20.js", "main": "src/worker-v21.js", "main": "src/worker-v22.js", "main": "src/worker-v23-production.js", "main": "src/worker-v24-production.js", "main": "src/worker-v25-production.js", "main": "src/worker-v26-production.js", "main": "src/worker-v27-production.js", "main": "src/worker-v28-production.js", "main": "src/worker-v29-production.js", "main": "src/worker-v30-production.js", "main": "src/worker-v31-production.js", "main": "src/worker-v32-production.js", "main": "src/worker-v33.js", "main": "src/worker-v34.js", "main": "src/worker-v35.js", "main": "src/worker-v36.js", "main": "src/worker-v37.js", "main": "src/worker-v38.js", "main": "src/worker-v39.js", "main": "src/worker-v40.js", "main": "src/worker-v41.js", "main": "src/worker-v42.js", "main": "src/worker-v42-hotfix.js", "main": "src/worker-v43.js", "main": "src/worker-v43-reviewfix.js", "main": "src/worker-v43-finalcandidate.js"
  "main": "src/worker-v44.js",
  "compatibility_date": "2026-09-09",
  "compatibility_flags": ["nodejs_compat"],
  "ai": { "binding": "AI" },
  "d1_databases": [{
    "binding": "TALKSYS_LOG_DB",
    "database_name": "talksys-conversation-logs",
    "database_id": "4d40b1c6-2436-4c5f-bb0a-e8e173a6d91a"
  }],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "migrations": [
    { "tag": "v1-voice", "new_sqlite_classes": ["TalkSysVoiceAgent"] },
    { "tag": "v33-delete-legacy-voice", "deleted_classes": ["TalkSysVoiceAgent"] }
  ]
}
