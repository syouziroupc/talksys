{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "talksys",
  // v33 intentionally removes the legacy Durable Object / WebSocket voice stack.
  // Rollback target before the rebuild: "main": "src/worker-v32-production.js"
  "main": "src/worker-v33.js",
  "compatibility_date": "2026-08-30",
  "compatibility_flags": ["nodejs_compat"],
  "ai": {
    "binding": "AI"
  }
}
